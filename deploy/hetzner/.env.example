# Copy to ".env" on the VPS and fill in real values:  cp .env.example .env
# Keep .env OUT of git (already covered by .gitignore patterns for **/.env).

# --- Database credentials -------------------------------------------------
# This single password is used BOTH for the Postgres container (POSTGRES_PASSWORD)
# and for the OpenMU app's connection string (DB_ADMIN_PW). They MUST match.
# Generate a strong one, e.g.:  openssl rand -base64 24
DB_ADMIN_USER=postgres
DB_ADMIN_PW=CHANGE_ME_to_a_long_random_password

# --- Image to run ---------------------------------------------------------
# The GitHub Actions workflow pushes here. Change only if your repo path differs.
OPENMU_IMAGE=ghcr.io/foyo-ai/openmu
# Tag deployed by the "production" branch workflow.
IMAGE_TAG=production
